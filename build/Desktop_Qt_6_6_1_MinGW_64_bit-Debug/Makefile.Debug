clean: compiler_clean 
	-$(DEL_FILE) debug\main.o debug\guipanel.o debug\crc.o debug\serial2USBprotocol.o debug\qrc_imagenes.o debug\moc_guipanel.o

distclean: clean 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) $(DESTDIR_TARGET)
	-$(DEL_FILE) Makefile.Debug

mocclean: compiler_moc_header_clean compiler_moc_objc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_objc_header_make_all compiler_moc_source_make_all

check: first

benchmark: first

compiler_no_pch_compiler_make_all:
compiler_no_pch_compiler_clean:
compiler_rcc_make_all: debug/qrc_imagenes.cpp
compiler_rcc_clean:
	-$(DEL_FILE) debug\qrc_imagenes.cpp
debug/qrc_imagenes.cpp: ../../imagenes.qrc \
		../../../../Qt/6.6.1/mingw_64/bin/rcc.exe \
		../../images/Map.png \
		../../images/frontal_inc.png \
		../../images/EngineButton.png \
		../../images/thermo.png \
		../../images/pressure.png \
		../../images/accel.png \
		../../images/planeTop2.png \
		../../images/lateral_inc.png \
		../../images/background_inc.png \
		../../images/broken-glass.png \
		../../images/EngineButtonStart.png \
		../../images/EngineButtonStop.png \
		../../images/Broken-Glass-PNG-Image-Transparent.png \
		../../images/Acelerometro.png \
		../../images/humidity.png
	D:\Qt\6.6.1\mingw_64\bin\rcc.exe -name imagenes --no-zstd ..\..\imagenes.qrc -o debug\qrc_imagenes.cpp

